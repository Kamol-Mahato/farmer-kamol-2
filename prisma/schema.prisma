generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SystemControlCenter {
  id                        Int     @id @default(1)
  enableOtpForGuest         Boolean @default(false)
  defaultLanguage           String  @default("BN")
  heroYoutubeUrl            String  @default("https://www.youtube.com/watch?v=default")
  maskCustomerData          Boolean @default(true)
  disableLiveCourierAPI     Boolean @default(true)
  paperSizeMode             String  @default("POS")
  invoicePrefix             String  @default("FK")
  useFreeWhatsAppOnly       Boolean @default(true)
  useGoogleSMTP             Boolean @default(true)
  minAmountForPaidSMS       Int     @default(2000)
  strictTxnUniqueCheck      Boolean @default(true)
  autoAdjustPrice           Boolean @default(true)
  qrCodeDestination         String  @default("TRACK")
  enableReviews             Boolean @default(false)
  enableCoupons             Boolean @default(false)
  enableWishlist            Boolean @default(false)
  enablePaymentGateway      Boolean @default(false)
  dhakaBaseCharge           Int     @default(75)
  dhakaExtraPerUnit         Int     @default(20)
  outsideBaseCharge         Int     @default(120)
  outsideExtraPerUnit       Int     @default(30)
  deliveryChargeMode        String  @default("NORMAL")
  normalDhakaBaseCharge     Int     @default(75)
  normalDhakaExtraPerUnit   Int     @default(20)
  normalOutsideBaseCharge   Int     @default(120)
  normalOutsideExtraPerUnit Int     @default(30)
  facebookPageUrl           String  @default("https://www.facebook.com/farmerkamol")
  youtubeChannelUrl         String  @default("https://www.youtube.com/@FarmerKamol")
  enableInvestmentProgram   Boolean @default(false)
}

model User {
  id                       Int                 @id @default(autoincrement())
  phone                    String              @unique
  name                     String?
  password                 String?
  role                     Role                @default(CUSTOMER)
  isActive                 Boolean             @default(true)
  walletBalance            Float               @default(0.0)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  otp                      String?
  otpExpiry                DateTime?
  otpAttempts              Int                 @default(0)
  passwordResetRequested   Boolean             @default(false)
  passwordResetRequestedAt DateTime?
  address                  String?
  upazila                  String?
  districtId               Int?
  district                 String?
  avatarUrl                String?
  agentLogs                AgentLog[]
  assignedChats            ChatConversation[]
  createdOrders            Order[]             @relation("AgentToOrder")
  customerOrders           Order[]             @relation("CustomerToOrder")
  reviews                  ProductReview[]
  walletTransactions       WalletTransaction[]
  investorProfile          InvestorProfile?
}

model Category {
  id            Int        @id @default(autoincrement())
  name          String
  slug          String     @unique
  description   String?
  displayOrder  Int        @default(0)
  isVisible     Boolean    @default(true)
  parentId      Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  nameEn        String?
  parent        Category?  @relation("CategoryToSub", fields: [parentId], references: [id], onDelete: Cascade)
  subCategories Category[] @relation("CategoryToSub")
  products      Product[]
}

model Product {
  id                  Int                      @id @default(autoincrement())
  name                String
  slug                String                   @unique
  description         String?
  categoryId          Int?
  pricePerUnit        Float
  discountPrice       Float?
  unit                String                   @default("কেজি")
  stockQty            Float
  isOutOfStockVisible Boolean                  @default(true)
  isFeatured          Boolean                  @default(false)
  isActive            Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  priceType           PriceType                @default(FIXED)
  descriptionEn       String?
  nameBanglish        String?
  nameEn              String?
  slugEn              String?                  @unique
  isTopSeller         Boolean                  @default(false)
  homeOrder           Int?
  orderItems          OrderItem[]
  category            Category?                @relation(fields: [categoryId], references: [id])
  batches             ProductBatch[]
  images              ProductImage[]
  packagingRecipes    ProductPackagingRecipe[]
  reviews             ProductReview[]
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  imageUrl  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductBatch {
  id               Int      @id @default(autoincrement())
  productId        Int
  batchNumber      String
  productionDate   DateTime
  expiryDate       DateTime
  quantityProduced Float
  notes            String?
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PackagingMaterial {
  id         Int                      @id @default(autoincrement())
  itemName   String
  stockCount Int                      @default(0)
  alertLimit Int                      @default(50)
  unitCost   Float
  recipes    ProductPackagingRecipe[]
}

model ProductPackagingRecipe {
  id           Int               @id @default(autoincrement())
  productId    Int
  materialId   Int
  quantityUsed Int               @default(1)
  material     PackagingMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductReview {
  id         Int      @id @default(autoincrement())
  productId  Int
  userId     Int
  rating     Int
  comment    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Coupon {
  id             Int          @id @default(autoincrement())
  code           String       @unique
  discountType   DiscountType
  discountValue  Float
  minOrderAmount Float        @default(0)
  maxDiscount    Float?
  usageLimit     Int?
  usedCount      Int          @default(0)
  isActive       Boolean      @default(true)
  expiryDate     DateTime?
  createdAt      DateTime     @default(now())
  orders         Order[]
}

model Order {
  id                Int              @id @default(autoincrement())
  customerId        Int
  orderSource       OrderSource      @default(WEBSITE)
  createdById       Int
  deliveryAddress   String
  customerNote      String?
  internalNote      String?
  totalProductPrice Float
  deliveryCharge    Float
  discountAmount    Float            @default(0.0)
  couponId          Int?
  finalCodAmount    Float
  courierProvider   String?
  courierTrackingId String?          @unique
  orderStatus       OrderStatus      @default(PENDING)
  paymentMethod     PaymentMethod    @default(COD)
  paymentStatus     PaymentStatus    @default(PENDING)
  gatewayName       String?
  gatewayTxnId      String?          @unique
  gatewayRef        String?
  paymentAmountPaid Float            @default(0.0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  dailySeq          Int              @default(0)
  collectedAmount   Float?
  district          String?
  districtId        Int?
  upazila           String?
  receivedQty       Float?
  courierPaidAmount Float?
  courierSummary    CourierSummary?
  invoice           Invoice?
  coupon            Coupon?          @relation(fields: [couponId], references: [id])
  creator           User             @relation("AgentToOrder", fields: [createdById], references: [id])
  customer          User             @relation("CustomerToOrder", fields: [customerId], references: [id], onDelete: Cascade)
  editLogs          OrderEditLog[]
  orderItems        OrderItem[]
  statusLogs        OrderStatusLog[]
}

model OrderStatusLog {
  id            Int      @id @default(autoincrement())
  orderId       Int
  fromStatus    String
  toStatus      String
  changedById   Int
  changedByRole String
  isOverride    Boolean  @default(false)
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderEditLog {
  id             Int      @id @default(autoincrement())
  orderId        Int
  editedById     Int
  editedByRole   String
  changesSummary String
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id         Int     @id @default(autoincrement())
  orderId    Int
  productId  Int
  quantity   Float
  finalPrice Float
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CourierSummary {
  id              Int      @id @default(autoincrement())
  orderId         Int      @unique
  courierStatus   String
  collectedAmount Float    @default(0.0)
  codFee          Float    @default(0.0)
  deliveryCharge  Float    @default(0.0)
  netPayout       Float    @default(0.0)
  isDiscrepancy   Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Invoice {
  id             Int      @id @default(autoincrement())
  orderId        Int      @unique
  invoiceNumber  String   @unique
  subTotal       Float
  deliveryCharge Float
  discountAmount Float    @default(0.0)
  advancePaid    Float    @default(0.0)
  finalCodAmount Float
  barcodeString  String
  qrCodeUrl      String
  printCount     Int      @default(0)
  lastPrintedBy  Int?
  secureToken    String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model NavigationMenu {
  id           Int              @id @default(autoincrement())
  title        String
  url          String
  displayOrder Int              @default(0)
  isVisible    Boolean          @default(true)
  parentId     Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  titleEn      String?
  parentMenu   NavigationMenu?  @relation("MenuToSubMenu", fields: [parentId], references: [id], onDelete: Cascade)
  subMenus     NavigationMenu[] @relation("MenuToSubMenu")
}

model AgentLog {
  id         Int      @id @default(autoincrement())
  agentId    Int
  action     String
  details    String
  targetId   Int?
  targetType String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  agent      User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model WalletTransaction {
  id        Int           @id @default(autoincrement())
  userId    Int
  amount    Float
  type      WalletTxnType
  reason    String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Blog {
  id            Int      @id @default(autoincrement())
  title         String
  slug          String   @unique
  content       String
  image         String?
  category      String
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  contentEn     String?
  slugEn        String?  @unique
  titleBanglish String?
  titleEn       String?
  homeOrder     Int?
}

model YoutubeVideo {
  id            Int      @id @default(autoincrement())
  title         String
  youtubeUrl    String
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  description   String?
  platform      String   @default("YOUTUBE")
  heroOrder     Int?
  descriptionEn String?
  titleEn       String?
  thumbnailUrl  String?
}

model GalleryItem {
  id            Int                @id @default(autoincrement())
  title         String
  description   String?
  displayOrder  Int                @default(0)
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  slug          String             @unique
  descriptionEn String?
  titleEn       String?
  slugEn        String?            @unique
  images        GalleryItemImage[]
}

model GalleryItemImage {
  id            Int         @id @default(autoincrement())
  galleryItemId Int
  imageUrl      String
  displayOrder  Int         @default(0)
  createdAt     DateTime    @default(now())
  galleryItem   GalleryItem @relation(fields: [galleryItemId], references: [id], onDelete: Cascade)
}

model BlogCategory {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  nameEn String?
}

model FosolCategory {
  id            Int         @id @default(autoincrement())
  name          String
  nameEn        String?
  slug          String      @unique
  description   String?
  descriptionEn String?
  displayOrder  Int         @default(0)
  isVisible     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         FosolItem[]
}

model FosolItem {
  id             Int           @id @default(autoincrement())
  title          String
  slug           String        @unique
  titleEn        String?
  slugEn         String?       @unique
  titleBanglish  String?
  content        String
  contentEn      String?
  image          String?
  scientificName String?
  season         String?
  seasonEn       String?
  region         String?
  regionEn       String?
  uses           String?
  usesEn         String?
  categoryId     Int
  isPublished    Boolean       @default(false)
  isFeatured     Boolean       @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  category       FosolCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([isPublished])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  role      String   @default("ADMIN")
}

model CustomerPushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model ChatConversation {
  id            Int           @id @default(autoincrement())
  visitorId     String        @unique
  visitorName   String?
  visitorPhone  String?
  status        ChatStatus    @default(OPEN)
  assignedToId  Int?
  lastMessageAt DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  assignedTo    User?         @relation(fields: [assignedToId], references: [id])
  messages      ChatMessage[]
}

model ChatMessage {
  id             Int              @id @default(autoincrement())
  conversationId Int
  senderType     ChatSenderType
  senderId       Int?
  text           String
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model InvestorProfile {
  id                   Int                        @id @default(autoincrement())
  userId               Int                        @unique
  user                 User                       @relation(fields: [userId], references: [id])
  email                String?                    @unique
  emailVerified        Boolean                    @default(false)
  fatherName           String?
  address              String?
  nidNumber            String?
  nidImageUrl          String?
  photoImageUrl        String?
  signatureImageUrl    String?
  paymentNumber        String?
  termsAcceptedAt      DateTime?
  profileCompletedAt   DateTime?
  verificationStatus   InvestorVerificationStatus @default(PENDING)
  verifiedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  investments          Investment[]
}

enum InvestorVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Project {
  id               Int          @id @default(autoincrement())
  name             String
  description      String?
  startDate        DateTime?
  isAcceptingFunds Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  investments      Investment[]
}

model Investment {
  id                Int              @id @default(autoincrement())
  investorProfileId Int
  investorProfile   InvestorProfile  @relation(fields: [investorProfileId], references: [id])
  projectId         Int
  project           Project          @relation(fields: [projectId], references: [id])
  amount            Float
  status            InvestmentStatus @default(PENDING)
  startDate         DateTime?
  termMonths        Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  transactions      Transaction[]
  agreement         Agreement?
}

model Transaction {
  id           Int               @id @default(autoincrement())
  investmentId Int
  investment   Investment        @relation(fields: [investmentId], references: [id])
  type         TransactionType
  amount       Float
  slipImageUrl String?
  status       TransactionStatus @default(PENDING)
  note         String?
  createdAt    DateTime          @default(now())
  confirmedAt  DateTime?
}

model Agreement {
  id             Int        @id @default(autoincrement())
  investmentId   Int        @unique
  investment     Investment @relation(fields: [investmentId], references: [id])
  agreementNo    String     @unique
  profitSharePct Float?
  documentUrl    String?
  generatedAt    DateTime   @default(now())
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

enum PriceType {
  FIXED
  NEGOTIABLE
}

enum Role {
  CUSTOMER
  AGENT
  ADMIN
  SUPER_ADMIN
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERY_ONGOING
  DELIVERED
  RETURNED
  CANCELLED
  REFUNDED
  LOST
  DAMAGED
  PAID_RETURN
  PARTIAL_DELIVERY
}

enum OrderSource {
  WEBSITE
  MESSENGER
  WHATSAPP
  CALL
  AGENT_MANUAL
}

enum PaymentMethod {
  COD
  GATEWAY
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL_PAID
}

enum WalletTxnType {
  CREDIT
  DEBIT
}

enum ChatStatus {
  OPEN
  CLOSED
}

enum InvestmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum ChatSenderType {
  CUSTOMER
  ADMIN
  AGENT
  SYSTEM
}
